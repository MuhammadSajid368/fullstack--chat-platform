NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public API prefix (matches frontend VITE_API_BASE_URL path)
API_PREFIX=/api

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT / session cookies
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=chat-api
JWT_AUDIENCE=chat-web
COOKIE_NAME=chat_session
COOKIE_SECURE=false
# Production MUST set COOKIE_SECURE=true (boot fails otherwise)
COOKIE_SAME_SITE=lax

# CORS — must match Vite origin exactly when credentials=true
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# Observability
METRICS_ENABLED=true
METRICS_ROUTE=/metrics
# Production MUST set METRICS_TOKEN (boot fails otherwise). Protects /metrics and /health/queues.
# METRICS_TOKEN=replace-with-long-secret
# METRICS_DEFAULT_LABELS=service=chat-backend,region=us-east-1
OTEL_ENABLED=false
OTEL_SERVICE_NAME=chat-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer token
OTEL_TRACES_SAMPLER_RATIO=0.1
OBSERVABILITY_STARTUP_TIMEOUT_MS=60000
