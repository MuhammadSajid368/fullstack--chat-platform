# =============================================================================
# Chat — PRODUCTION environment template
# Copy to `.env` (never commit secrets):
#   cp .env.production.example .env
# =============================================================================

# ---- Compose / ports ----
HTTP_PORT=80
HTTPS_PORT=443
GRAFANA_PORT=3001
TLS_CERTS_DIR=./deploy/certs

# ---- Postgres ----
POSTGRES_USER=chat
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=chat

# ---- Redis ----
# REDIS_URL is composed inside docker-compose.prod.yml as redis://redis:6379
# For external Redis, override backend REDIS_URL in compose override.

# ---- Backend (required production secrets) ----
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_characters!!
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_characters!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=chat-api
JWT_AUDIENCE=chat-web
COOKIE_NAME=chat_session
# COOKIE_SECURE is forced true in docker-compose.prod.yml
COOKIE_SAME_SITE=lax

# Public browser origin (scheme + host[:port]) — must match the URL users open.
# Behind TLS: https://chat.example.com
CORS_ORIGIN=https://chat.example.com

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOG_LEVEL=info

# Required in production (app refuses to boot without it)
METRICS_TOKEN=CHANGE_ME_long_metrics_scrape_token
METRICS_DEFAULT_LABELS=service=chat-backend,env=production

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=chat-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER_RATIO=0.1
OBSERVABILITY_STARTUP_TIMEOUT_MS=60000

# ---- Frontend build args (baked at image build time) ----
VITE_APP_NAME=Chat
VITE_API_TIMEOUT_MS=15000

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password
GRAFANA_ROOT_URL=https://chat.example.com/grafana
