# HTTPS-ready template. Mount TLS certs and enable this file in production.
# Example compose mounts:
#   ./certs/fullchain.pem → /etc/nginx/certs/fullchain.pem
#   ./certs/privkey.pem   → /etc/nginx/certs/privkey.pem
#
# Rename to default-ssl.conf (or include) after certificates exist.

