# =============================================================================
# Chat — STAGING environment template
# Copy to `.env` for staging or local compose:
#   cp .env.staging.example .env
# =============================================================================

# ---- Compose / ports (dev-friendly) ----
HTTP_PORT=8080
HTTPS_PORT=8443
BACKEND_PORT=3000
FRONTEND_PORT=8081
POSTGRES_PORT=5432
REDIS_PORT=6379
GRAFANA_PORT=3001
TLS_CERTS_DIR=./deploy/certs

# ---- Postgres ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chat

# ---- Backend ----
JWT_ACCESS_SECRET=staging-access-secret-min-32-characters!
JWT_REFRESH_SECRET=staging-refresh-secret-min-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=chat-api
JWT_AUDIENCE=chat-web
COOKIE_NAME=chat_session
COOKIE_SAME_SITE=lax

# Browser origin for the edge nginx (or Vite when not using compose frontend)
CORS_ORIGIN=http://localhost:8080

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
LOG_LEVEL=debug

METRICS_TOKEN=staging-metrics-token
METRICS_DEFAULT_LABELS=service=chat-backend,env=staging

OTEL_ENABLED=false
OTEL_SERVICE_NAME=chat-backend
OTEL_TRACES_SAMPLER_RATIO=0.2
OBSERVABILITY_STARTUP_TIMEOUT_MS=60000

# ---- Frontend build args ----
VITE_APP_NAME=Chat (Staging)
VITE_API_TIMEOUT_MS=15000

# ---- Grafana (optional on staging) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=staging-grafana-password
GRAFANA_ROOT_URL=http://localhost:3001
