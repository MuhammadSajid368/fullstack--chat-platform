# Chat service mode: mock | rest
# Use `rest` to talk to the real backend (Vite proxies /api and /socket.io).
VITE_CHAT_SERVICE_MODE=rest

# REST API base URL. Same-origin `/api` so the Vite proxy can forward cookies
# and inject Authorization from the access cookie for domain API routes.
VITE_API_BASE_URL=/api

# Socket.IO URL. Leave empty to use window.location.origin (proxied via /socket.io).
VITE_SOCKET_URL=

# Optional request timeout in milliseconds (default 15000)
VITE_API_TIMEOUT_MS=15000

# Optional app display name
# VITE_APP_NAME=Chat
